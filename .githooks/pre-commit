#!/bin/sh
# pre-commit hook. Shells out to Makefile targets rather than reimplementing
# the checks, so a commit is verified with the same commands as `make check`
# and CI. A check added in one place is added in all three.
#
# Installed by `make hooks` (which sets core.hooksPath). Bypass a run with
# `git commit --no-verify`.
#
# Every check is repo-wide: `go vet` and `go test` are package-scoped, and
# prettier is pointed at the whole tree by `.prettierignore`. The patterns
# below therefore decide only *whether* a check runs, not what it looks at.

set -e

staged="$(git diff --cached --name-only --diff-filter=ACMRT)"

matched() {
	printf '%s\n' "$staged" | grep -Eq "$1"
}

run() {
	printf '\n> %s\n' "$*"
	"$@"
}

# Ordered fastest first, so an obvious failure does not wait behind the test
# suite.
if matched '\.go$|^go\.(mod|sum)$'; then
	run make fmt-check
fi

# prettier reads its own config, so a change to that config is a reason to
# re-check the tree.
if matched '\.(md|json|ya?ml)$|^\.prettier(rc|ignore)$'; then
	run make format-check
fi

if matched '\.go$|^go\.(mod|sum)$'; then
	run make vet
fi

# Skipped with a note when golangci-lint is absent, matching the Makefile
# target. CI runs it either way.
if matched '\.go$|^go\.(mod|sum)$|^\.golangci\.ya?ml$'; then
	run make lint-go
fi

# Without -race: that pass belongs to CI, which can afford the wall time.
if matched '\.go$|^go\.(mod|sum)$'; then
	run make test
fi
